<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards based custom ruleset for your plugin">
	<description>Generally-applicable sniffs for WordPress plugins.</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>

	<!-- How to scan -->
	<!-- Usage instructions: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Usage -->
	<!-- Annotated ruleset: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="basepath" value="./"/><!-- Strip the file paths down to the relevant bit -->
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/><!-- Enables parallel processing when available for faster results. -->

	<!-- Rules: Check PHP version compatibility -->
	<!-- https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="8.1-"/>
	<!-- https://github.com/PHPCompatibility/PHPCompatibilityWP -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Rules: WordPress Coding Standards -->
	<!-- https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards -->
	<!-- https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards/wiki/Customizable-sniff-properties -->
	<config name="minimum_supported_wp_version" value="6.2"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<!-- Value: replace the function, class, and variable prefixes used. -->
			<property name="prefixes" type="array">
				<element value="stf_"/>
				<element value="STF_"/>
				<element value="scripts_to_footer"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<!-- Value: replace the text domain used. -->
			<property name="text_domain" type="array">
				<element value="scripts-to-footerphp"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<!--
	Rules: test stack exceptions.
	Each one is scoped to the single file that needs it and to the single sniff code that
	fires there. Test code must define WordPress core constants and functions, which cannot
	carry the plugin prefix.
	-->

	<!-- Bootstraps and test fixtures must define WordPress core constants (ABSPATH, WP_UNINSTALL_PLUGIN, WP_TESTS_PHPUNIT_POLYFILLS_PATH, WP_TESTS_CONFIG_FILE_PATH, DB_*, ...) by their exact core names, so they cannot be prefixed. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/php/unit/bootstrap\.php$</exclude-pattern>
		<exclude-pattern>/tests/php/unit/UninstallTest\.php$</exclude-pattern>
		<exclude-pattern>/tests/php/Support/fixtures/uninstall-direct-access\.php$</exclude-pattern>
		<exclude-pattern>/tests/php/integration/bootstrap\.php$</exclude-pattern>
		<exclude-pattern>/tests/php/integration/UninstallTest\.php$</exclude-pattern>
		<exclude-pattern>/tests/php/integration/wp-tests-config\.php$</exclude-pattern>
	</rule>

	<!-- The unit suite's wp_die() stand-in must be named exactly wp_die(), because that is the function uninstall.php calls, so it cannot be prefixed. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedFunctionFound">
		<exclude-pattern>/tests/php/Support/wp-die\.php$</exclude-pattern>
	</rule>

	<!-- The direct-access fixture replaces the WordPress functions uninstall.php would call after its guard with marker stubs, so they must carry the exact core names and cannot be prefixed. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedFunctionFound">
		<exclude-pattern>/tests/php/Support/fixtures/uninstall-direct-access\.php$</exclude-pattern>
	</rule>

	<!-- The direct-access test must run uninstall.php in a separate PHP process, because the guard branch calls exit(); proc_open() is the only way to capture its stdout and stderr separately. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_proc_open">
		<exclude-pattern>/tests/php/unit/UninstallTest\.php$</exclude-pattern>
	</rule>

	<!-- wp-tests-config.php must set $table_prefix: the WordPress test library before 6.3 reads that global, and the file is loaded inside a function scope by the library. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>/tests/php/integration/wp-tests-config\.php$</exclude-pattern>
	</rule>
</ruleset>
