{
  "name": "joshuadavidnelson/scripts-to-footer",
  "type": "wordpress-plugin",
  "description": "Move your scripts to the footer to help speed up perceived page load times and improve user experience.",
  "homepage": "https://github.com/joshuadavidnelson/scripts-to-footer/",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Joshua David Nelson",
      "email": "josh@joshuadnelson.com"
    }
  ],
  "support": {
    "issues": "https://github.com/joshuadavidnelson/scripts-to-footer/issues",
    "forum": "https://wordpress.org/support/plugin/scripts-to-footer/",
    "docs": "https://github.com/joshuadavidnelson/scripts-to-footer/wiki"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5.24",
    "10up/wp_mock": "^1.1.1",
    "yoast/phpunit-polyfills": "^4.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/php-compatibility": "*",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "php-stubs/wordpress-tests-stubs": "^7.1",
    "johnbillion/wp-compat": "^3.0",
    "sirbrillig/phpcs-variable-analysis": "^3.0",
    "squizlabs/php_codesniffer": "^3.7",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpmd/phpmd": "^2.15",
    "phpmetrics/phpmetrics": "^2.8",
    "mockery/mockery": "^1.6",
    "wp-phpunit/wp-phpunit": "^6.8"
  },
  "scripts": {
    "lint": [
      "find *.php includes/ tests/ -type f -name '*.php' -print0 | xargs -0 -L1 -P4 -- php -l"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --memory-limit=2048M"
    ],
    "phpunit": [
      "./vendor/bin/phpunit"
    ],
    "phpunit:coverage": [
      "@php -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text"
    ],
    "phpunit:coverage-html": [
      "@php -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-html coverage"
    ],
    "phpunit:coverage-clover": [
      "@php -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-clover coverage/php-clover.xml --coverage-text"
    ],
    "phpunit:integration": [
      "./vendor/bin/phpunit -c phpunit-integration.xml.dist"
    ],
    "test": [
      "@phpunit"
    ],
    "test:integration": [
      "@phpunit:integration"
    ],
    "phpcs": [
      "./vendor/bin/phpcs"
    ],
    "phpcbf": [
      "./vendor/bin/phpcbf"
    ],
    "phpmd": [
      "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmd scripts-to-footer.php,uninstall.php,includes/ text phpmd.xml"
    ],
    "phpmetrics": [
      "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmetrics --report-html=reports/metrics --report-json=reports/metrics.json scripts-to-footer.php,uninstall.php,includes/"
    ],
    "phpmetrics-summary": [
      "@php -r \"is_dir('reports') || mkdir('reports', 0777, true);\"",
      "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmetrics --composer=false --report-summary-json=reports/metrics-summary.json scripts-to-footer.php,uninstall.php,includes/"
    ]
  },
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.1.99"
    }
  }
}
