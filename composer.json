{
  "name": "joshuadavidnelson/scripts-to-footer",
  "type": "wordpress-plugin",
  "description": "Move your scripts to the footer to help speed up perceived page load times and improve user experience.",
  "homepage": "https://github.com/joshuadavidnelson/scripts-to-footer/",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Joshua David Nelson",
      "email": "josh@joshuadnelson.com"
    }
  ],
  "support": {
    "issues": "https://github.com/joshuadavidnelson/scripts-to-footer/issues",
    "forum": "https://wordpress.org/support/plugin/scripts-to-footer/",
    "docs": "https://github.com/joshuadavidnelson/scripts-to-footer/wiki"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/php-compatibility": "*",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "php-stubs/wordpress-tests-stubs": "^6.7",
    "johnbillion/wp-compat": "^1.3",
    "sirbrillig/phpcs-variable-analysis": "^2.12",
    "squizlabs/php_codesniffer": "^3.7",
    "php-stubs/wordpress-stubs": "^7.1",
    "10up/wp_mock": "^1.1",
    "yoast/phpunit-polyfills": "^4.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.8"
  },
  "scripts": {
    "lint": [
      "find *.php includes/ tests/ -type f -name '*.php' -print0 | xargs -0 -L1 -P4 -- php -l"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --memory-limit=2048M"
    ],
    "phpcs": [
      "./vendor/bin/phpcs"
    ],
    "phpcbf": [
      "./vendor/bin/phpcbf"
    ],
    "test": [
      "./vendor/bin/phpunit"
    ],
    "test:integration": [
      "./vendor/bin/phpunit -c phpunit-integration.xml.dist"
    ],
    "test:coverage": [
      "@php -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text"
    ],
    "test:coverage-clover": [
      "@php -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-clover coverage/clover.xml --coverage-text"
    ],
    "test:coverage-check": [
      "@php tests/php/bin/check-coverage.php coverage/clover.xml 90"
    ]
  },
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
