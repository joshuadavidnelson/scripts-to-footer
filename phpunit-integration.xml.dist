<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="./tests/php/integration/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         convertDeprecationsToExceptions="true"
         cacheResultFile=".phpunit.cache/integration-results">
    <testsuites>
        <testsuite name="integration">
            <directory suffix="Test.php">./tests/php/integration/</directory>
        </testsuite>
    </testsuites>
    <coverage cacheDirectory=".phpunit.cache/integration-code-coverage">
        <include>
            <directory suffix=".php">includes/</directory>
            <file>uninstall.php</file>
        </include>
        <exclude>
            <file>includes/index.php</file>
        </exclude>
    </coverage>
</phpunit>
